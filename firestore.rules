rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // FUNCIONES DE AUTENTICACIÓN Y ROLES
    // =============================================
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email in ['elinquisidor09@gmail.com', 'milkavv.2001@gmail.com'];
    }
    
    function isSuperVendedor() {
      return request.auth != null && request.auth.token.email in ['garyvv.1993@gmail.com', 'abrahamjimenez092003@gmail.com'];
    }
    
    function isVendedor() {
      return request.auth != null && request.auth.token.email in ['amvf280194@gmail.com', 'noeatlas28@gmail.com'];
    }
    
    function isAdmin() {
      return isSuperAdmin() || isSuperVendedor();
    }
    
    function hasAccessToSales() {
      return isAdmin() || isVendedor();
    }
    
    // =============================================
    // REGLAS POR COLECCIÓN
    // =============================================

    match /products/{productId} {
      allow get, list: if request.auth != null;
      allow create, delete: if isSuperAdmin();

      // --- LA CORRECCIÓN CLAVE ESTÁ AQUÍ ---
      // Se separa la lógica de actualización. Los administradores pueden actualizar cualquier campo del producto.
      // Los vendedores solo pueden actualizar el stock (necesario para las ventas).
      allow update: if isAdmin() || 
                      (hasAccessToSales() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockReal']) &&
                       request.resource.data.stock >= 0);

      // Subcolección de lotes
      match /lotes/{loteId} {
        // Los administradores tienen control total sobre los lotes para poder hacer ajustes.
        // `read` es atajo para `get` y `list`. `write` es atajo para `create`, `update`, `delete`.
        allow read, write: if isAdmin();
      }
    }

    match /sales/{saleId} {
      allow get, list, create: if hasAccessToSales();
      allow update: if (isAdmin()) || 
                    (hasAccessToSales() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalCost', 'profit', 'lotesInfo']));
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /movimientos_inventario/{movimientoId} {
      allow read, write: if isAdmin();
    }

    match /movimientos_caja/{movimientoId} {
      allow create: if hasAccessToSales();
      allow read, update, delete: if isAdmin();
    }

    match /compras/{compraId} {
      allow read, write: if isAdmin();
    }

    match /proveedores/{proveedorId} {
      allow read, write: if isAdmin();
    }
    
    match /arqueos_caja/{arqueoId} {
      allow read, write: if isAdmin();
    }

    match /historial_lotes/{historialId} {
      allow read, write: if isAdmin();
    }

    match /stock_por_lote/{stockId} {
      allow read: if hasAccessToSales();
      allow write: if isAdmin();
      allow update: if hasAccessToSales() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad', 'ultimaActualizacion']) &&
                    request.resource.data.cantidad >= 0;
    }

    match /ganancia_neta_acumulada/{document} {
      allow read, write: if isAdmin();
    }
  }
}