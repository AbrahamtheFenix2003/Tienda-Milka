// public/sw.js — iOS-safe minimal SW
// Forzar actualización cambiando esta versión
const VERSION = 'v13-safari-lite';
const CACHE_NAME = `tienda-cache-${VERSION}`;

// Activa el modo iOS Safari (no intercepta fetch)
const SAFARI_IOS_MODE = true;

// (Opcional) lista de archivos para precache en navegadores NO iOS
const urlsToCache = ['/', '/index.html', '/login-cliente.html'];

/* INSTALL */
self.addEventListener('install', (event) => {
  if (SAFARI_IOS_MODE) {
    // En iOS NO precacheamos, solo activamos de inmediato
    event.waitUntil(self.skipWaiting());
  } else {
    // Otros navegadores: precache básico
    event.waitUntil(
      caches.open(CACHE_NAME)
        .then((cache) => cache.addAll(urlsToCache))
        .then(() => self.skipWaiting())
    );
  }
});

/* ACTIVATE */
self.addEventListener('activate', (event) => {
  event.waitUntil(
    (async () => {
      // Elimina TODAS las cachés para garantizar frescura
      const names = await caches.keys();
      await Promise.all(names.map((n) => caches.delete(n)));
      await self.clients.claim();
    })()
  );
});

/* MESSAGE: controlar actualización y limpieza de caché */
self.addEventListener('message', async (event) => {
  const reply = (payload) => {
    if (event.ports && event.ports[0]) {
      event.ports[0].postMessage(payload);
    }
  };

  try {
    const data = event.data || {};
    if (data.type === 'SKIP_WAITING') {
      await self.skipWaiting();
      reply({ success: true, message: 'SW activado inmediatamente' });
      return;
    }

    if (data.type === 'CLEAR_CACHE') {
      const names = await caches.keys();
      await Promise.all(names.map((n) => caches.delete(n)));
      reply({ success: true, message: 'Caché limpiada completamente' });
      return;
    }

    if (data.type === 'CLEAR_PRODUCT_CACHE') {
      const cache = await caches.open(CACHE_NAME);
      const keys = await cache.keys();
      const deletions = keys
        .filter((request) => {
          const u = new URL(request.url);
          return (
            u.origin === self.location.origin &&
            (u.pathname.includes('/produto') ||
             u.pathname.includes('/producto') ||
             u.searchParams.has('id'))
          );
        })
        .map((req) => cache.delete(req));
      await Promise.all(deletions);
      reply({ success: true, message: 'Caché de productos limpiada' });
      return;
    }
  } catch (err) {
    reply({ success: false, error: (err && err.message) || String(err) });
  }
});

/* FETCH */
self.addEventListener('fetch', (event) => {
  const req = event.request;
  const url = new URL(req.url);

  // Solo GET
  if (req.method !== 'GET') return;

  // No interceptar navegaciones (documentos HTML)
  if (req.mode === 'navigate' || req.destination === 'document') return;

  // iOS SAFARI: NO interceptar NADA (evita cuelgues CORS/preflight)
  if (SAFARI_IOS_MODE) return;

  // Para otros navegadores: solo mismo-origen
  if (url.origin !== self.location.origin) return;

  // Nunca interceptar páginas de producto
  if (
    url.pathname.includes('/produto') ||
    url.pathname.includes('/producto') ||
    url.searchParams.has('id')
  ) {
    return;
  }

  // Network-first con fallback a caché (sin forzar cache-mode)
  event.respondWith(
    (async () => {
      try {
        const fresh = await fetch(req);
        const cache = await caches.open(CACHE_NAME);
        cache.put(req, fresh.clone());
        return fresh;
      } catch (e) {
        const cached = await caches.match(req);
        if (cached) return cached;
        throw e;
      }
    })()
  );
});
